{
  "$schema": "https://tr.designtokens.org/format/",
  "archetype": "06-agentic-command-workspace",
  "color": {
    "surface": {
      "canvas": {
        "$type": "color",
        "$value": "oklch(0.12 0.01 255)"
      },
      "elevated": {
        "$type": "color",
        "$value": "oklch(0.17 0.012 255)"
      }
    },
    "ink": {
      "primary": {
        "$type": "color",
        "$value": "oklch(0.95 0.005 255)"
      },
      "muted": {
        "$type": "color",
        "$value": "oklch(0.64 0.01 255)"
      }
    },
    "accent": {
      "primary": {
        "$type": "color",
        "$value": "oklch(0.70 0.16 195)"
      }
    },
    "border": {
      "hairline": {
        "$type": "color",
        "$value": "oklch(0.25 0.012 255)"
      }
    }
  },
  "fontFamily": {
    "display": {
      "$type": "fontFamily",
      "$value": "Uncut Sans"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": "Satoshi"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "Fragment Mono"
    }
  },
  "dimension": {
    "maxBorderRadius": {
      "$type": "dimension",
      "$value": "6px"
    }
  },
  "motion": {
    "primaryEasing": {
      "$type": "string",
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "durationMin": {
      "$type": "duration",
      "$value": "160ms"
    },
    "durationMax": {
      "$type": "duration",
      "$value": "380ms"
    }
  }
}
